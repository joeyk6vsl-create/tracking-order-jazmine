# ใช้ฐานข้อมูลฝังในเครื่องเมื่อไม่กำหนด DATABASE_URL
NODE_ENV=development
PORT=3100
WEB_ORIGIN=http://localhost:5173
LOCAL_DATA_DIR=./local-data/postgres
# เครื่องมือนี้เลือก Edge ใน Windows อัตโนมัติ ผู้ติดตั้งระบุ Edge/Chromium อื่นได้
# JAZMINE_PDF_BROWSER=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# สำเนากู้คืนอยู่แยกจากฐานปัจจุบัน ใช้ค่าเริ่มต้นนี้เมื่อไม่ได้กำหนด
# LOCAL_RECOVERY_ROOT=./local-data/recovery
# ตัวเปิดสำเนากำหนดโหมดกู้คืนและช่องเปิดแยกให้เอง ไม่ต้องแก้ค่าในเครื่องปกติ
# JAZMINE_RECOVERY_MODE=0
# เครื่องใช้งานจริงต้องกำหนด DATABASE_URL, WEB_ORIGIN แบบ HTTPS และ TLS ฐานข้อมูล
# DATABASE_URL=postgresql://user:password@localhost:5432/jazmine
