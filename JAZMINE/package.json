{
  "name": "jazmine",
  "version": "0.2.0",
  "private": true,
  "description": "ระบบ JAZMINE — ผู้ใช้ สิทธิ์ และลูกค้าประจำ",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.server.json && pnpm build:documents",
    "build:documents": "vite build --config apps/web/vite.documents.config.mts",
    "build:web": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.mts",
    "start": "node dist/apps/server/src/main.js",
    "worker": "node dist/apps/worker/src/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p apps/web/tsconfig.json",
    "lint": "eslint apps packages database/migrate.ts scripts tests eslint.config.mjs",
    "format:code": "prettier --write apps packages scripts tests database/migrate.ts *.json *.mjs",
    "test": "pnpm build:server && node --test --test-concurrency=1 dist/tests/integration/*.test.js",
    "test:e2e": "pnpm build:server && node tests/e2e/identity-flow.mjs && node tests/e2e/tracking-reports-search.mjs && node tests/e2e/backups.mjs && node tests/e2e/production-revisions.mjs && node tests/e2e/production-reversals.mjs && node tests/e2e/issue-corrections.mjs && node tests/e2e/order-lifecycle.mjs && node tests/e2e/gift-only.mjs && node tests/e2e/invoice-tracking.mjs && node tests/e2e/quotations.mjs && node tests/e2e/stored-documents.mjs && node tests/e2e/payment-qr.mjs && node tests/e2e/archive-document-status.mjs",
    "test:load": "pnpm build:server && node tests/load/local-volume.mjs latest",
    "db:migrate": "pnpm build:server && node dist/database/migrate.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fontsource/noto-sans-lao": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5"
  }
}
